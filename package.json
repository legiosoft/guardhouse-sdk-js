{
  "name": "guardhouse-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "echo '✅ Packages linked successfully'",
    "build": "npm run build:core && npm run build:apps",
    "build:core": "npm run build -w @guardhouse/core",
    "build:apps": "npm run build -w @guardhouse/node -w @guardhouse/react -w @guardhouse/react-native",
    "clean": "rm -rf node_modules packages/*/dist packages/*/node_modules"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "prettier": "latest"
  }
}
