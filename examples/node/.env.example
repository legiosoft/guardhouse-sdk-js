# Guardhouse Authority URL
AUTHORITY=https://your-guardhouse-domain.com

# Browser authorization-code client
CLIENT_ID=your-client-id
# Set only if this authorization-code client is confidential.
CLIENT_SECRET=

# OAuth redirect URI for authorization code flow
REDIRECT_URI=http://localhost:3001/callback

# OAuth Scopes
SCOPE=openid profile email offline_access

# Separate confidential service client for client_credentials.
# Use an API scope granted to the service client, not the OIDC user scopes above.
SERVICE_CLIENT_ID=your-service-client-id
SERVICE_CLIENT_SECRET=your-service-client-secret
SERVICE_SCOPE=your-api-scope

# Resource Server (for protected API endpoints)
AUDIENCE=your-api-audience

# Server Port
PORT=3001

# Comma-separated browser origins allowed to call this API
CORS_ORIGINS=http://localhost:5173
