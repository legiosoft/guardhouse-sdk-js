GH_AUTHORITY=https://your-guardhouse-domain.com
GH_CLIENT_ID=your-client-id
GH_REDIRECT_URI=com.example.guardhouse://callback
GH_SCOPE=openid profile email offline_access
GH_AUDIENCE=
GH_AUTHORIZATION_ENDPOINT=/connect/authorize
GH_REGISTRATION_ENDPOINT=/account/signup
GH_TOKEN_ENDPOINT=/connect/token
GH_REVOCATION_ENDPOINT=/connect/revocation
GH_PASSKEY_CHALLENGE_ENDPOINT=/connect/webauthn/challenge
GH_PASSKEY_ASSERTION_ENDPOINT=/connect/webauthn/verify
# Optional: override discovered JWKS endpoint
GH_JWKS_URI=
# Optional: comma or space-separated values (e.g. urn:mace:incommon:iap:silver)
GH_REQUIRED_ACR_VALUES=
# Optional: comma or space-separated values (e.g. pwd otp)
GH_REQUIRED_AMR_VALUES=
# Optional: true/false
GH_REQUIRE_WEBAUTHN=false
# Optional: true/false
GH_REQUIRE_PHISHING_RESISTANT_MFA=false
# Expo Go compatibility: set true to allow claims-only ID token validation
GH_ALLOW_INSECURE_ID_TOKEN_VALIDATION=true
GH_API_BASE_URL_ANDROID=http://10.0.2.2:3001
GH_API_BASE_URL_IOS=http://localhost:3001
