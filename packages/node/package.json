{
  "name": "@guardhouse/node",
  "version": "1.0.2-beta.1",
  "description": "Backend SDK for Node.js with JWT validation middleware and Admin API client",
  "keywords": [
    "guardhouse",
    "sdk",
    "node",
    "nodejs",
    "express",
    "middleware",
    "oauth2",
    "oidc",
    "jwt",
    "authentication",
    "authorization",
    "jwks",
    "api",
    "rest"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legiosoft/guardhouse-sdk-js.git"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.{ts,md,json}\""
  },
  "dependencies": {
    "@guardhouse/core": "2.0.0-beta.1",
    "jsonwebtoken": "9.0.2",
    "jwks-rsa": "3.1.0"
  },
  "peerDependencies": {
    "express": "^4.22.2"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.0",
    "@types/express": "4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "9.0.6",
    "express": "4.22.2",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "tsup": "8.5.1",
    "typescript": "5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
