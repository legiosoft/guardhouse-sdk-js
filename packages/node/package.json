{
  "name": "@guardhouse/node",
  "version": "1.0.0-beta.1",
  "description": "Backend SDK for Node.js with JWT validation middleware and Admin API client",
  "keywords": [
    "guardhouse",
    "sdk",
    "node",
    "nodejs",
    "express",
    "middleware",
    "oauth2",
    "oidc",
    "jwt",
    "authentication",
    "authorization"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legiosoft/guardhouse-sdk-js.git"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.{ts,md,json}\""
  },
  "dependencies": {
    "@guardhouse/core": "1.0.0",
    "jsonwebtoken": "9.0.2",
    "jwks-rsa": "3.1.0",
    "react-native": "0.75.5"
  },
  "peerDependencies": {
    "express": "^4.22.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "9.0.6",
    "jest": "^25.0.0",
    "ts-jest": "^29.1.2",
    "tsup": "8.5.1",
    "typescript": "5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
