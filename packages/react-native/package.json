{
  "name": "@guardhouse/react-native",
  "version": "1.0.2-beta.1",
  "description": "React Native SDK for Guardhouse OAuth PKCE, passkey auth, and secure token lifecycle",
  "keywords": [
    "guardhouse",
    "sdk",
    "react-native",
    "mobile",
    "oauth2",
    "oidc",
    "pkce",
    "passkey",
    "webauthn",
    "authentication",
    "deep-linking",
    "secure-storage",
    "keychain",
    "typescript"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "Apache-2.0",
  "author": "Guardhouse",
  "homepage": "https://github.com/legiosoft/guardhouse-sdk-js#readme",
  "bugs": {
    "url": "https://github.com/legiosoft/guardhouse-sdk-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legiosoft/guardhouse-sdk-js.git",
    "directory": "packages/react-native"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,md,json}\""
  },
  "dependencies": {
    "@guardhouse/core": "2.0.0-beta.1",
    "jwt-decode": "^4.0.0",
    "react-native-inappbrowser-reborn": "^3.7.0",
    "react-native-keychain": "^10.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.70.0",
    "react-native-quick-crypto": ">=0.7.0"
  },
  "peerDependenciesMeta": {
    "react-native-quick-crypto": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.75.5",
    "@testing-library/react-native": "^11.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.28",
    "jest": "^29.7.0",
    "react": "18.3.1",
    "react-native": "^0.75.5",
    "react-test-renderer": "18.3.1",
    "ts-jest": "^29.4.6",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "jest": {
    "preset": "react-native",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}"
    ],
    "coverageThreshold": {
      "./src/utils/idToken.ts": {
        "branches": 70,
        "functions": 100,
        "lines": 90,
        "statements": 90
      }
    },
    "moduleNameMapper": {
      "^@guardhouse/(core)$": "<rootDir>/../core/src",
      "^@guardhouse/react-native/(.+)$": "<rootDir>/src/$1"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
